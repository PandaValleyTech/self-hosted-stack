# Homebox settings. Copy to .env and fill in the secrets.
# This file is also passed to the container, so any HBOX_* option from
# https://homebox.software/en/quick-start/configure/ can be added here.

# Container name (NPM forwards to <this>:7745). Leave as is here;
# scripts/new-instance.sh sets it for extra instances.
HOMEBOX_INSTANCE=homebox

# User the container runs as. Must be able to write data/.
HOMEBOX_UID=1000
HOMEBOX_GID=1000

# openssl rand -base64 48 | tr -d '\n'
# Keep it stable: changing it invalidates every API key.
HBOX_AUTH_API_KEY_PEPPER=

# Turn off once the first account exists. Only affects the local sign-up
# form: OIDC still creates accounts (Authentik decides who gets in).
HBOX_OPTIONS_ALLOW_REGISTRATION=true

# Maximum upload size in MB (photos, receipts, manuals).
# HBOX_WEB_MAX_UPLOAD_SIZE=25

# --- SSO with Authentik (see README.md) ---
# HBOX_OIDC_ENABLED=true
# HBOX_OIDC_ISSUER_URL=https://authentik.example.com/application/o/homebox/
# HBOX_OIDC_CLIENT_ID=
# HBOX_OIDC_CLIENT_SECRET=
# HBOX_OIDC_BUTTON_TEXT=Sign in with Authentik
# Only once SSO works for everyone:
# HBOX_OPTIONS_ALLOW_LOCAL_LOGIN=false
