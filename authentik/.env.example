# Authentik settings. Copy to .env and fill in the secrets.
#   PG_PASS:              openssl rand -base64 36 | tr -d '\n'
#   AUTHENTIK_SECRET_KEY: openssl rand -base64 60 | tr -d '\n'
# Any other AUTHENTIK_* setting added here is passed to the containers.

AUTHENTIK_TAG=2026.8.3

PG_USER=authentik
PG_DB=authentik
PG_PASS=
AUTHENTIK_SECRET_KEY=
