# Paperless-ngx settings. Copy to .env and fill in the secrets.
# This file is also passed to the container, so any PAPERLESS_* option from
# https://docs.paperless-ngx.com/configuration/ can be added here.
#   PAPERLESS_DBPASS:     openssl rand -base64 36 | tr -d '\n'
#   PAPERLESS_SECRET_KEY: openssl rand -base64 48 | tr -d '\n'
# Don't change the DB credentials after the first start; Postgres keeps the
# ones it was initialised with. Changing the secret key logs everyone out.

# Public HTTPS URL, no trailing slash.
PAPERLESS_URL=https://paperless.example.com
PAPERLESS_SECRET_KEY=

PAPERLESS_DBNAME=paperless
PAPERLESS_DBUSER=paperless
PAPERLESS_DBPASS=

# Host user that owns data/ and the consume folder.
PAPERLESS_UID=1000
PAPERLESS_GID=1000

# Folder Paperless watches for new documents (scanner target, network share).
PAPERLESS_CONSUME_PATH=./data/consume

# OCR language(s) of most of your documents (Tesseract codes, e.g. eng, deu).
PAPERLESS_OCR_LANGUAGE=eng

# --- SSO with Authentik (see README.md) ---
# PAPERLESS_APPS=allauth.socialaccount.providers.openid_connect
# PAPERLESS_SOCIALACCOUNT_PROVIDERS='{"openid_connect":{"OAUTH_PKCE_ENABLED":true,"APPS":[{"provider_id":"authentik","name":"Authentik","client_id":"<client id>","secret":"<client secret>","settings":{"server_url":"https://authentik.example.com/application/o/paperless/.well-known/openid-configuration"}}]}}'
# PAPERLESS_SOCIAL_AUTO_SIGNUP=true
# PAPERLESS_SOCIALACCOUNT_ALLOW_SIGNUPS=true
# PAPERLESS_DISABLE_REGULAR_LOGIN=false
# PAPERLESS_REDIRECT_LOGIN_TO_SSO=false
