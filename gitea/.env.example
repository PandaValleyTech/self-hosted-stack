# Gitea settings. Copy to .env and fill in the secrets.
#   GITEA_DB_PASS: openssl rand -base64 36 | tr -d '\n'
# Don't change the DB credentials after the first start; Postgres keeps the
# ones it was initialised with (see README.md to rotate).

GITEA_DB_NAME=gitea
GITEA_DB_USER=gitea
GITEA_DB_PASS=

# Host port for git over SSH (shown in clone URLs).
GITEA_SSH_PORT=2222
