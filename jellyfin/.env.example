# Jellyfin settings. Copy to .env and adjust.

# Container name (NPM forwards to <this>:8096). Leave as is here;
# scripts/new-instance.sh sets it for extra instances.
JELLYFIN_INSTANCE=jellyfin

# Public HTTPS URL, e.g. https://jellyfin.example.com
JELLYFIN_URL=

# Host folder with your media (movies/, shows/, music/, ...). Mounted at
# /media, writable so Jellyfin can save artwork/NFO/trickplay next to it.
JELLYFIN_MEDIA_PATH=./data/media

# User the container runs as. Must be able to read and write the media and
# data/config and data/cache.
JELLYFIN_UID=1000
JELLYFIN_GID=1000
