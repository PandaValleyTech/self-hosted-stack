# KitchenOwl settings. Copy to .env and fill in the secrets.
# This file is also passed to the backend container, so any option from
# https://docs.kitchenowl.org/latest/self-hosting/advanced/ can be added here.
#   JWT_SECRET_KEY: openssl rand -base64 48 | tr -d '\n'
# Changing the JWT secret logs everyone out.

KITCHENOWL_VERSION=v0.8.1

JWT_SECRET_KEY=

# Public HTTPS URL, exactly as users reach it (scheme, no trailing slash).
# Used for CORS and as the base of the OIDC redirect URI.
FRONT_URL=https://kitchenowl.example.com

# --- SSO with Authentik (see README.md) ---
# OIDC_ISSUER=https://authentik.example.com/application/o/kitchenowl/
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# Only once SSO works for everyone:
# DISABLE_USERNAME_PASSWORD_LOGIN=true
