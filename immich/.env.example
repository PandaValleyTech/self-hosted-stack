# Immich settings. Copy to .env and fill in the secrets.
#   IMMICH_DB_PASS: openssl rand -hex 32
# Use letters and digits only for the DB password (Immich's requirement).
# Don't change the DB credentials after the first start; Postgres keeps the
# ones it was initialised with.

# Prefix for container names (immich-server, ...). Leave as is here;
# scripts/new-instance.sh sets it for extra instances.
IMMICH_INSTANCE=immich

# Pin to a release and upgrade deliberately. Read the release notes first.
IMMICH_VERSION=v3.4.2

IMMICH_DB_NAME=immich
IMMICH_DB_USER=immich
IMMICH_DB_PASS=

# Where photos and videos live on the host. Can be large; point it at a big
# disk or a mounted share. Database dumps also land here, under backups/.
IMMICH_UPLOAD_PATH=./data/library

# Set to HDD if data/postgres is on spinning disks.
IMMICH_DB_STORAGE_TYPE=SSD
